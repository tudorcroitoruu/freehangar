#pragma kernel ClearWater
#pragma kernel FloodWater

// State encoding per cell:
// bit 0      active
// bit 1      source
// bits 4..7  rotated pipe mask: up, down, left, right
// bit 8      water

StructuredBuffer<uint> stateIn;
RWStructuredBuffer<uint> stateOut;
int _Width;
int _Height;

uint HasBit(uint mask, uint bit)
{
    return (mask & bit) != 0u ? 1u : 0u;
}

uint Opposite(uint bit)
{
    if (bit == 1u) return 2u;
    if (bit == 2u) return 1u;
    if (bit == 4u) return 8u;
    return 4u;
}

int2 StepForBit(uint bit)
{
    if (bit == 1u) return int2(0, 1);
    if (bit == 2u) return int2(0, -1);
    if (bit == 4u) return int2(-1, 0);
    return int2(1, 0);
}

[numthreads(64, 1, 1)]
void ClearWater(uint3 id : SV_DispatchThreadID)
{
    int index = (int)id.x;
    int total = _Width * _Height;
    if (index >= total) return;

    uint cell = stateIn[index];
    cell &= ~256u;
    if ((cell & 2u) != 0u)
        cell |= 256u;
    stateOut[index] = cell;
}

[numthreads(64, 1, 1)]
void FloodWater(uint3 id : SV_DispatchThreadID)
{
    int index = (int)id.x;
    int total = _Width * _Height;
    if (index >= total) return;

    uint cell = stateIn[index];
    if ((cell & 1u) == 0u)
    {
        stateOut[index] = cell;
        return;
    }

    uint water = cell & 256u;
    uint mask = (cell >> 4) & 15u;
    int x = index % _Width;
    int y = index / _Width;

    uint bits[4] = { 1u, 2u, 4u, 8u };
    for (int i = 0; i < 4; i++)
    {
        uint bit = bits[i];
        if (HasBit(mask, bit) == 0u) continue;

        int2 s = StepForBit(bit);
        int nx = x + s.x;
        int ny = y + s.y;
        if (nx < 0 || nx >= _Width || ny < 0 || ny >= _Height) continue;

        int ni = ny * _Width + nx;
        uint ncell = stateIn[ni];
        if ((ncell & 1u) == 0u || (ncell & 256u) == 0u) continue;

        uint nmask = (ncell >> 4) & 15u;
        if (HasBit(nmask, Opposite(bit)) != 0u)
        {
            water = 256u;
            break;
        }
    }

    stateOut[index] = (cell & ~256u) | water;
}
