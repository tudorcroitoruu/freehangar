--- !u!114 &8853995741842851025
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 616121213133621049}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a2087f9c1c8a2149802105fdec0d6d0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WarningPopup
  warningPresets:
  - warningType: 0
    icon: {fileID: 21300000, guid: 61b1d4b711a750e4cb3d9e82b7198267, type: 3}
    title: Rats are eating your grain!
    message: Equip broom, then left-click to scare them away.
  - warningType: 1
    icon: {fileID: 21300000, guid: a10637ae3dcac3148823790bc7a300b8, type: 3}
    title: Crows are stealing your grain!
    message: Equip broom, then left-click to scare them away.
  - warningType: 2
    icon: {fileID: 21300000, guid: 8f975711fbce5d440a2c0fe7f1d11fbf, type: 3}
    title: Cannot Enter
    message: 'This vehicle cannot enter the hangar.

      Use wheelbarrow instead'
  - warningType: 3
    icon: {fileID: 21300000, guid: 8f434169ee7756b4a81881acf9073a17, type: 3}
    title: Vehicle Full
    message: There is not enough space on this vehicle for the container you are
      carrying.
  - warningType: 4
    icon: {fileID: 21300000, guid: 5ccd02182dc7e0c4d8b79b20c5b260b5, type: 3}
    title: Make room to get off
    message: Move the vehicle to a clear area before getting off.
  - warningType: 5
    icon: {fileID: 21300000, guid: 1db5b5c6786310a469cc742081466ade, type: 3}
    title: The hands are occupied
    message: Free up your hands so you can grasp something new.
  - warningType: 6
    icon: {fileID: 21300000, guid: 0946ae989cb7f0b4b8a844f31f312b91, type: 3}
    title: Clear the delivery area
    message: There's no room to place the bag in the delivery area.
  - warningType: 7
    icon: {fileID: 21300000, guid: 9737fc54409396d46ae2e1a810bfb078, type: 3}
    title: Use Forklift
    message: Use forklift to move
  - warningType: 9
    icon: {fileID: 21300000, guid: add56af62cb972d48a834de40a428c42, type: 3}
    title: Tool not found
    message: Find "Axe" in the grain pile in Hangar 1.
  - warningType: 10
    icon: {fileID: 21300000, guid: ed14aaec73c521d4b9f61d64a3ca8ac0, type: 3}
    title: Tool not found
    message: Find "Hammer" in the grain pile in Hangar 3.
  - warningType: 11
    icon: {fileID: 21300000, guid: 47e852e0065a6f04f83f217d7904557c, type: 3}
    title: Bag locked
    message: Bag is locked
  - warningType: 12
    icon: {fileID: 21300000, guid: 0c28da6489224b24cb7c275970fef04c, type: 3}
    title: Dog resting
    message: Let the dog rest
  - warningType: 14
    icon: {fileID: 21300000, guid: 6a201bbef21689c4ba34dec6c59fee5b, type: 3}
    title: Too large
    message: Container is too large for this wheelbarrow.
  - warningType: 15
    icon: {fileID: 21300000, guid: ed6a3d57b9710a4488b1dc68418124c0, type: 3}
    title: Mix grain block
    message: Shovel contain another type of grains.
  - warningType: 16
    icon: {fileID: 21300000, guid: 6819a9a56d080c548b7ac4a1a1b470e9, type: 3}
    title: Mix grain block
    message: Container contain another type of grains.
  - warningType: 17
    icon: {fileID: 21300000, guid: 9f9276166852bf34d80f4c610f33e8dc, type: 3}
    title: Not hungry
    message: There is no need in spending money on food.
  - warningType: 18
    icon: {fileID: 21300000, guid: 08e03b8b6ed13d44cbc7cbcf208440fc, type: 3}
    title: Weighing empty.
    message: Place some containers on weighing.
  - warningType: 19
    icon: {fileID: 21300000, guid: 0ffc3075f09d4c747bd2625f383bbcf9, type: 3}
    title: Invalid Items on Scale
    message: Remove all items except grain containers from the scale.
  - warningType: 20
    icon: {fileID: 21300000, guid: d8de98f94d278ab459a60ad342f4913b, type: 3}
    title: Cannot load
    message: Finish filling and close bag.
  - warningType: 21
    icon: {fileID: 21300000, guid: 53e47783cd0224b4cb7111f1b05d1120, type: 3}
    title: Missing key!
    message: Requires key for this chest.
  - warningType: 22
    icon: {fileID: 21300000, guid: fb132969e43b46e41925b2e53585e622, type: 3}
    title: Hangar locked
    message: 
  warningCanvasGroup: {fileID: 737507088087375577}
  warningImage: {fileID: 6193481453998981383}
  warningTitle: {fileID: 11493426258684311}
  warningMessage: {fileID: 8959166986674553238}
  rotationSeconds: 3
